{
    "name": "sphil",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "h": "jq '.scripts' package.json",
        "content:meta": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/generate-meta-manifest.ts",
        "content:check": "bun run scripts/content/compile-all.ts",
        "predev": "pnpm run content:meta",
        "prebuild": "pnpm run content:meta",
        "dev": "next dev",
        "email:dev": "email dev --dir lib/email/templates",
        "build": "pnpm run lint && pnpm run ct && next build",
        "start": "next start",
        "lint": "biome lint",
        "ct": "tsc --pretty --noEmit",
        "cd:dev": "gh workflow run cd_dev.yaml --ref $(git rev-parse --abbrev-ref HEAD)",
        "prettier:check": "npx prettier --check .",
        "postbuild": "pagefind --site .next/standalone/.next/server/app --output-path public/_pagefind",
        "stripe:listen": "stripe listen --forward-to 127.0.0.1:3000/api/stripe-webhook",
        "db:studio": "dotenv -e .env -- npx prisma studio",
        "db:studio:prod": "dotenv -e .env.production -- npx prisma studio",
        "db:regen": "npx prisma generate",
        "db:push": "npx prisma db push",
        "db:push:prod": "dotenv -e .env.production -- npx prisma db push",
        "email:send-news": "dotenv -e .env -- bun run scripts/email/send-newsletter.tsx",
        "email:send-news:prod": "dotenv -e .env.production -- bun run scripts/email/send-newsletter.tsx",
        "email:send-seminars": "bun run scripts/email/send-seminar-email.tsx",
        "email:send-reminders": "bun run scripts/email/send-seminar-reminder.tsx"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.11.3",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/server": "^11.11.0",
        "@emotion/styled": "^11.14.1",
        "@google-cloud/storage": "^8.0.1",
        "@mdx-js/mdx": "^3.1.1",
        "@mdxeditor/editor": "3.14.0",
        "@mui/icons-material": "^7.3.10",
        "@mui/material": "^7.3.10",
        "@mui/material-nextjs": "^7.3.10",
        "@mui/x-date-pickers": "^8.28.3",
        "@prisma/client": "^6.19.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/typography": "^0.5.20",
        "@types/bun": "1.3.3",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "assemblyai": "^4.36.7",
        "classnames": "^2.5.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.20",
        "framer-motion": "^12.38.0",
        "github-slugger": "^2.0.0",
        "gray-matter": "^4.0.3",
        "mermaid": "^11.17.0",
        "minimatch": "^10.2.6",
        "next": "^16.3.2",
        "next-auth": "5.0.0-beta.32",
        "next-themes": "^0.4.6",
        "posthog-js": "^1.418.10",
        "prettier": "3.6.2",
        "prisma": "^6.19.3",
        "react": "^19.2.5",
        "react-cookie-consent": "^10.0.2",
        "react-dom": "^19.2.5",
        "react-email": "^6.9.2",
        "react-hook-form": "7.62.0",
        "react-hot-toast": "^2.6.0",
        "react-textarea-autosize": "^8.5.9",
        "rehype-external-links": "^3.0.0",
        "rehype-pretty-code": "^0.14.5",
        "rehype-raw": "^7.0.0",
        "remark-directive": "^3.0.1",
        "remark-gfm": "^4.0.1",
        "remark-smartypants": "^3.0.3",
        "resend": "^6.12.2",
        "sharp": "^0.35.3",
        "shiki": "^4.4.3",
        "stripe": "^18.5.0",
        "tailwind-merge": "^3.5.0",
        "tailwindcss": "^4.2.4",
        "typescript": "5.9.3",
        "unist-util-visit": "^5.1.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@auth/core": "^0.41.3",
        "@biomejs/biome": "2.3.8",
        "@types/node": "25.6.0",
        "baseline-browser-mapping": "^2.10.21",
        "dotenv-cli": "^10.0.0",
        "pagefind": "1.4.0"
    },
    "overrides": {
        "glob": "^11.1.0",
        "mdast-util-to-hast": "13.2.1",
        "jws": "4.0.1"
    },
    "trustedDependencies": [
        "@prisma/client",
        "prisma",
        "bun",
        "@prisma/engines",
        "esbuild",
        "sharp",
        "core-js"
    ],
    "packageManager": "pnpm@11.22.0"
}
